easyblock = 'ConfigureMake'

name = 'geopsy'
version = '3.4.2'

homepage = 'https://www.geopsy.org/'
description = """Graphical environment to view, organize and process signals. Most of the geophysical file formats are
automatically recognized. Geopsy features can be extended through plugin tools. A selection is available here below."""

toolchain = {'name': 'foss', 'version': '2022a'}

source_urls = ['https://www.geopsy.org/download/archives/']
sources = ['geopsypack-src-%(version)s.tar.gz']
patches = ['geopsy-3.4.2-replace_hardcoded_blas.patch']
checksums = [
    {'geopsypack-src-3.4.2.tar.gz': '5e0114fe32fe01cb9d46713a201462a8c284c43d9dd6c60afaca23f6d76b621f'},
    {'geopsy-3.4.2-replace_hardcoded_blas.patch': '8bcdf026253034a6898bf4d9e04c5acda320bf28b5a3343a2c44e8a8af4d9fb3'},
]

dependencies = [
    ('Qt5', '5.15.5'),
]

configopts = '-accept-license'
prefix_opt = '-prefix '

local_binaries = [
    'dinver', 'geopsy-fk', 'geopsy-spac', 'gpdc', 'gpdepths', 'gpell', 'gpgroup2phase', 'gpmaplayer', 'gpparam2model',
    'gprandom', 'gpsh', 'gpspac', 'gpviewdcreport', 'max2curve', 'vslarray', 'figue', 'geopsy-hv', 'gpcoord',
    'gpdcmisfit', 'gpdistance', 'gpfksimulator', 'gphistogram', 'gpmodel2param', 'gppoisson', 'gprefra', 'gpsignal',
    'gptarget', 'gpviewmax', 'screenpicker', 'waran', 'geopsy', 'GeopsyLand', 'gpcurve', 'gpdcreport', 'gpec8',
    'gpgridsearch', 'gplivemodel', 'gpmt', 'gpprofile', 'gpreplace', 'gpsort', 'gptime', 'gpvoronoi',
    'spac2disp', 'warangps'
]

local_libraries = [
    'ArrayCore', 'ArrayGui', 'DinverCore', 'DinverDCCore', 'DinverDCGui', 'DinverGui', 'GeopsyCore', 'GeopsyGui',
    'GeopsySLink', 'GeopsySLinkGui', 'HVCore', 'HVGui', 'QGpCoreMath', 'QGpCoreStat', 'QGpCoreTools',
    'QGpCoreWave', 'QGpGuiMath', 'QGpGuiTools', 'QGpGuiWave', 'SciFigs', 'WaranCore',
]

sanity_check_paths = {
    'files': [f'bin/{b}' for b in local_binaries] + [f'lib/lib{l}.{SHLIB_EXT}' for l in local_libraries],
    'dirs': ['bin',] + [f'include/{l}' for l in local_libraries] + [
        f'share/{l}' for l in ['DinverCore', 'geopsyarray', 'GeopsyLand', 'lang']
    ],
}
sanity_check_commands = ["geopsy --version"]

moduleclass = 'tools'
